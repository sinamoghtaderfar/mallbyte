# Copy to .env.production on the server and supply real secrets via your secrets manager.
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MFA_FERNET_KEY=REPLACE_WITH_FERNET_GENERATE_KEY_OUTPUT
ALLOWED_HOSTS=api.example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://shop.example.com
CORS_ALLOWED_ORIGINS=https://shop.example.com
SECURE_SSL_REDIRECT=True

DB_HOST=YOUR_POSTGRES_HOST
DB_PORT=5432
DB_NAME=mallbyte
DB_USER=mallbyte_runtime
DB_PASSWORD=REPLACE_WITH_SECRET
DB_SSLMODE=require
# Prefer DB_SSLMODE=verify-full and specify your provider CA certificate:
# DB_SSLROOTCERT=/run/secrets/postgres-ca.crt

REDIS_URL=rediss://YOUR_REDIS_HOST:6379/0?ssl_cert_reqs=required
CACHE_BACKEND=redis
CACHE_REDIS_URL=rediss://YOUR_REDIS_HOST:6379/1?ssl_cert_reqs=required
CELERY_BROKER_URL=rediss://YOUR_REDIS_HOST:6379/0?ssl_cert_reqs=required
CELERY_RESULT_BACKEND=rediss://YOUR_REDIS_HOST:6379/1?ssl_cert_reqs=required

# Configure a real provider. Do not use console email in production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=YOUR_SMTP_HOST
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=YOUR_SMTP_USER
EMAIL_HOST_PASSWORD=REPLACE_WITH_SECRET
DEFAULT_FROM_EMAIL=noreply@api.example.com

# Used by scripts/mallbyte-server.py; use unique local tags or approved image digests.
MALLBYTE_BACKEND_IMAGE=mallbyte-backend:production-local
MALLBYTE_FRONTEND_IMAGE=mallbyte-frontend:production-local
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
API_PORT=8000
GATEWAY_PORT=8080
FRONTEND_PORT=3000
